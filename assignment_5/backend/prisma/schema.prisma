datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tasks     Task[]
  goals     Goal[]
}

model Task {
  id          String    @id @default(uuid())
  title       String
  isCompleted Boolean   @default(false)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // User Relation
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Self-referential Relation for Subtasks
  // This matches your frontend design where subtasks use flat relational parentId keys
  parentId    String?
  parent      Task?     @relation("TaskToSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]    @relation("TaskToSubtasks")
}

model Goal {
  id         String    @id @default(uuid())
  title      String
  progress   Int       @default(0) // Logic will clamp this between 0 and 100
  targetDate DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // User Relation
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}